# Required in production: generate a unique random secret (at least 32 bytes).
# Example generation: openssl rand -base64 32
COOKIE_CONSENT_SECRET=

# Optional: Geo-IP enrichment for ISP/organization/approximate location.
# If configured, visitor IPs are sent to IPinfo only after explicit report consent.
IPINFO_TOKEN=

# Optional: cookie consent status/category reports only; never receives cookie values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for persistent shortlinks on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
